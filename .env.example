# ==============================================================================
# Environment variables — [PROJECT_NAME]
# ==============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
#
# NEVER commit your `.env` file with real values to the repository.
# Real values live in your credential manager and this `.env` is generated from
# there. See SECURITY.md and docs/conventions/secrets.md.
# ==============================================================================

# ── Environment ───────────────────────────────────────────────────────────
# Runtime environment: development | production
# (there is no staging: `develop` is the integration environment — docs/conventions/deploy.md)
APP_ENV=development
# Port the application listens on
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────
# Database (record the engine in docs/architecture/stack.md)
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────
# Secret for signing tokens/sessions (generate a long random one)
AUTH_SECRET=
# Token expiry time
AUTH_TOKEN_TTL=7d

# ── AI ────────────────────────────────────────────────────────────────────
# This template sets NO default provider: it is chosen per product and recorded in
# docs/architecture/stack.md. Switching providers should be changing these three
# variables — if it requires touching code, the adapter layer is not doing its
# job. A generic capability (text, embeddings) is portable; an exclusive one is not.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# A second provider, configured from day 1 with the tests running against it. If
# you have never executed it, you are not portable: you only believe you are.
AI_PROVIDER_FALLBACK=
AI_API_KEY_FALLBACK=

# ── Cross-cutting services ────────────────────────────────────────────────
# ONE VARIABLE PER CATEGORY, not per provider: the template does not choose your
# services. Rename each one after the provider you pick in
# docs/architecture/stack.md (e.g. PAYMENTS_API_KEY → <YOURPROVIDER>_API_KEY),
# uncomment only the ones this product actually has, and reflect it in
# docs/architecture/stack.md.
# PAYMENTS_API_KEY=          # payments
# PAYMENTS_WEBHOOK_SECRET=   # verify the signature over the raw body
# EMAIL_API_KEY=             # transactional email
# STORAGE_ACCESS_KEY_ID=     # file storage (S3-compatible)
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=          # endpoint of the S3-compatible service
# ERROR_TRACKING_DSN=        # errors
# ANALYTICS_API_KEY=         # product analytics
# ANALYTICS_PERSONAL_API_KEY= # PERSONAL API key — only if an MCP uses it (.mcp.json)

# ── Backups (scripts/backup-db.sh) ────────────────────────────────────────
# Daily database dump to an S3-compatible bucket. The backup bucket is DIFFERENT
# from the app's file bucket: an accidental delete in one cannot take the other.
# BACKUP_S3_ENDPOINT=        # endpoint of the S3-compatible service
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=          # e.g. myapp-backups
# BACKUP_PREFIX=db           # prefix inside the bucket
# BACKUP_RETENTION_DAYS=30   # days the dumps are kept

# ── Other APIs ────────────────────────────────────────────────────────────
# Every third-party API goes behind an adapter of your own: the business logic
# does not know the provider.
API_KEY=
API_URL=

# ── Logging ───────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Other variables ───────────────────────────────────────────────────────
# Add whatever this product needs here and document what each one is for.
