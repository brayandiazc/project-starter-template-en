#!/usr/bin/env bash
# pre-push — runs locally the same checks as the CI `Quality` job.
#
# Why: in a private repository GitHub Actions minutes are finite, and finding a
# broken link in CI costs a whole run. These checks take ~15 seconds here and cost
# nothing, so CI stops being the verification loop and becomes the safety net.
#
# This hook DOES block (unlike pre-commit): a broken link or a red test is not
# formatting noise, it is something to fix before publishing.
#
# Enabling (once per clone, not versioned in .git/config):
#   git config core.hooksPath .githooks
#
# Skipping it just this once: git push --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

# Without the scripts (a project that deleted them when instantiating), there is
# nothing to do.
[ -d .github/scripts ] || exit 0

# Each entry: "label<TAB>command". Same order as .github/workflows/quality.yml.
CHECKS=(
	"Format (Prettier)	.github/scripts/format.sh --check"
	"Internal links	.github/scripts/check-links.sh"
	"Placeholders	.github/scripts/check-placeholders.sh"
	"Template inheritance	.github/scripts/check-inheritance.sh"
	"Design system	.github/scripts/check-design-tokens.sh"
	"README instructions	.github/scripts/check-instructions.sh"
	"Template test suite	.github/scripts/tests/run-tests.sh"
	"Project test suite	.github/scripts/check-project-tests.sh"
)

echo "pre-push: checking the same things as CI…" >&2
failures=()
output="$(mktemp)"
trap 'rm -f "$output"' EXIT

for entry in "${CHECKS[@]}"; do
	label="${entry%%$'\t'*}"
	command="${entry#*$'\t'}"
	script="${command%% *}"

	# A script that no longer exists is not a failure: the project may have pruned it.
	[ -f "$script" ] || continue

	# We do not stop at the first failure — same as the workflow's `!cancelled()`,
	# so you see every problem at once instead of one at a time.
	if bash $command > "$output" 2>&1; then
		printf '  ✅ %s\n' "$label" >&2
	else
		printf '  ❌ %s\n' "$label" >&2
		sed 's/^/       /' "$output" | tail -8 >&2
		failures+=("$label")
	fi
done

if [ "${#failures[@]}" -gt 0 ]; then
	echo >&2
	echo "pre-push: ${#failures[@]} check(s) red — the push stops here." >&2
	printf '   · %s\n' "${failures[@]}" >&2
	echo >&2
	echo "   Fix them and push again. The emergency exit exists" >&2
	echo "   ('git push --no-verify'), but it disables ALL the checks in the list" >&2
	echo "   above at once — and if CI is not running (minutes exhausted, private" >&2
	echo "   repo), this hook is the only filter left: nobody else will warn you." >&2
	echo "   If the failure looks like a false positive of the check itself, the" >&2
	echo "   thing to do is fix the check (and take it back to the template), not" >&2
	echo "   bypass it." >&2
	exit 1
fi

echo "pre-push: all green." >&2
exit 0
